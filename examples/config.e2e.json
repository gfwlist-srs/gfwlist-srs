        "download_detour": "direct"
      },
      {
        "type": "remote",
        "tag": "gfwlist-block",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/gfwlist-srs/gfwlist-srs@main/dist/gfwlist-block.srs",
        "download_detour": "direct"
      }
    ],
    "final": "direct",
    "auto_detect_interface": true
  }
