{
  "log": { "level": "debug", "timestamp": true },
  "inbounds": [
    { "type": "mixed", "tag": "in", "listen": "127.0.0.1", "listen_port": 17890 }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" }
  ],
  "route": {
    "rules": [
      { "rule_set": "gfwlist-exception", "action": "route", "outbound": "direct" },
      { "rule_set": "gfwlist-block", "action": "route", "outbound": "direct" }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "gfwlist-exception",
